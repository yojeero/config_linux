//  GitHub: https://github.com/yojeero

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",	
  "logo": {  
    "type": "small",
    "padding": {
      "top": 2,
      "left": 2
    }
  },
  "display": {
        "separator": ": ",
        "key": { "width": 10 }
    },
  "modules": [
    "title",    
    "break", 
   {
      "type": "os",
      "key": "OS",
      "keyColor": "3"
    },
    {
      "type": "kernel",
      "key": "Core",
      "keyColor": "3"
    },
    {
      "type": "packages",
      "key": "Pkgs",
      "keyColor": "3"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "3"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "3"
    },
    {
      "type": "terminal",
      "format": "{1}",
      "key": "Term",
      "keyColor": "3"
    },
    {
      "type": "terminalfont",
      "key": "Font",     
      "format": "{2} / {size}",
      "keyColor": "3",
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "3"
    },
    "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
    "break"
  ]
}

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // "logo": {
  //   "type": "none"
  // },
  "logo": {
    "source": "printf '\\033[1;32m%s\\033[0m\\n' \"$(grep PRETTY_NAME /etc/os-release | cut -d '\"' -f2)\"",
    "position": "top",
    "padding": {
      "top": 1
    }
  },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#34}{icon} distro  {#keys}│",
            "type": "os",
            "format": "{2}"
        },
        {
            "key": "│ {#35} kernel     {#keys}│",
            "type": "kernel",
            "format": "{2}"
        },
        {
            "key": "│ {#32} pkgs     {#keys}│",
            "type": "packages",
            "format": "{1}"
        },
        {
            "key": "│ {#36} wm     {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {#36}󰇄 de     {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#31} term     {#keys}│",
            "type": "terminal",
            "format": "{1}"
        },
        {
            "key": "│ {#32} font     {#keys}│",
            "type": "terminalfont"
        },
        {
            "key": "│ {#32} theme      {#keys}│",
            "type": "theme"
        },
        {
            "key": "│ {#32} icons      {#keys}│",
            "type": "icons"
        },
        {
            "key": "│ {#33}󰍛 cpu      {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#33}󰍛 display      {#keys}│",
            "type": "display",
            "format": "{1}x{2}"
        },
        {
            "key": "│ {#33}󰢮 gpu      {#keys}│",
            "type": "gpu"
        },
        {
            "key": "│ {#34}󰉉 disk     {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#36} swap     {#keys}│",
            "type": "swap"
        },
        {
            "key": "│ {#36} memory     {#keys}│",
            "type": "memory"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors     {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}

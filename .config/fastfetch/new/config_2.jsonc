{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "printf '\\033[1;32m%s\\033[0m\\n' \"$(grep PRETTY_NAME /etc/os-release | cut -d '\"' -f2)\"",
        "position": "top",
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": "yellow",
        "key": {
            "width": 10
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "╭────────────────────────╮",
            "outputColor": "white"
        }, 
        {
            "type": "os",
            "key": "      distro",
            "keyColor": "yellow",
            "format": "{2}"
        },
        {
            "type": "kernel",
            "key": "      kernel",
            "keyColor": "green",
            "format": "{2}"
        },
        {
            "type": "packages",
            "key": "      pkgs",
            "keyColor": "red",
            "format": "{1}"
        },
        {
            "type": "wm",
            "key": "      wm",
            "keyColor": "red"
        },
        {
            "type": "de",
            "key": "      de",
            "keyColor": "red"
        },
        {
            "type": "packages",
            "key": "      pkgs",
            "keyColor": "red",
            "format": "{1}"
        },
        {
            "type": "terminal",
            "key": "      term",
            "keyColor": "red",
            "format": "{1}"        
        },
        {
            "type": "terminalfont",
            "key": "      font",
            "keyColor": "red"
        },
        {
            "type": "theme",
            "key": "      theme",
            "keyColor": "red"
        },
        {
            "type": "icons",
            "key": "      icons",
            "keyColor": "red"
        },
        {
            "type": "cpu",
            "key": "      cpu",
            "keyColor": "red",
            "showPeCoreCount": true
        },
        {
            "type": "display",
            "key": "      display",
            "keyColor": "red",
            "format": "{1}x{2}"
        },
        {
            "type": "gpu",
            "key": "      gpu",
            "keyColor": "red"
        },
        {
            "type": "swap",
            "key": "      swap",
            "keyColor": "red"
        },
        {
            "type": "memory",
            "key": "      memory",
            "keyColor": "yellow",
            "format": "{1} | {2}"
        },
        {
            "type": "custom",
            "format": "├────────────────────────┤",
            "outputColor": "white"
        },
        {
            "type": "colors",
            "key": "      colors",
            "symbol": "circle"
        },
        {
            "type": "custom",
            "format": "╰────────────────────────╯",
            "outputColor": "white"
        }
    ]
}

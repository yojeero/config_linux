{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",	
  "logo": {  
    "type": "small",
    "color": {"2": "yellow"},
    "padding": 0
  },
    "display": {
    "separator": "  "  
    },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10
    },
    "break",
    {
      "type": "os",
      "key": "╭─{icon} Distro",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": "├─ Kernel",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "├─ Packages",
      "keyColor": "green"
    },
    {
      "type": "de",
      "key": "├─ DE",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": "├─ WM",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "format": "{1}",
      "key": "├─ Terminal",
      "keyColor": "green"
    },
    {
      "type": "terminalfont",
      "key": "├─ Font",
      "keyColor": "green"
    },
    {
      "type": "theme",
      "key": "├─ Theme",
      "keyColor": "green"
    },
    {
      "type": "icons",
      "key": "├─ Icons",
      "keyColor": "green"
    },
    {
      "type": "display",
	    "format": "{1}x{2}",
      "key": " ├─ Display",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "├─ CPU",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "├─ GPU",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "├─ Disk",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "├─ Swap",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "╰─ Memory",
      "keyColor": "green"
    },
    "break",
    {
      "type": "custom", 
      "key": " pacman", 
      "format": "\u001b[31m󰮯  \u001b[32m󰊠  \u001b[33m󰊠  \u001b[34m󰊠  \u001b[30m󰊠 "      
    },
    "break",
    "break"
  ]
}

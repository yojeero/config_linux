# su      01;32   # SETUID
# sg      01;32   # SETGID
# ex      01;32   # EXEC
# fi      00      # FILE

#
# nord theme inspired colors for lf
#

# file types (with matching order)
ln      03;36 # LINK
or      31 # ORPHAN
tw      34 # STICKY_OTHER_WRITABLE
ow      34 # OTHER_WRITABLE
st      36 # STICKY
di      34 # DIR
pi      36 # FIFO
so      33 # SOCK
bd      33 # BLK
cd      33 # CHR
su      37 # SETUID
sg      37 # SETGID
ex      32 # EXEC
fi      00 # FILE


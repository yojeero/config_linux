
# basics #############################
set shell sh
set tabstop 4
set shellopts '-eu'
set ifs "\n"
# leave some space at the top and the bottom of the screen
set scrolloff 10
# display file size & count items in dir
set info size
set dircounts
# show icons
#set icons
map I set icons!
map zi set icons!
# pane ratios
set ratios 1:2:3
# auto-reload
set period 1
# message
set waitmsg '--press any key to continue--'
# escape clear
map <esc> clear
# clear selection after paste
map p :paste; clear
# touch & mkdir command
map a :push %touch<space>
map A :push %mkdir<space>
# move current file or selected files to trash folder
cmd trash $trash-put $fx
map T trash
# delete file or selected files
map D delete
map <delete> delete
# set pane_path when changing directory
cmd on-cd &printf "\033]0; $PWD\007" > /dev/tty
on-cd

# configuration ################################
#cmd edit-config $$EDITOR ~/.config/lf/lfrc; lf -remote "send $id source ~/.config/lf/lfrc"
cmd edit-config $nano ~/.config/lf/lfrc; lf -remote "send $id source ~/.config/lf/lfrc"
map C edit-config

# preview #######################################
# preview files & dir
set preview
set previewer ~/.config/lf/pv.sh
# toggle preview
map zvq set preview!
# preview only text file
map zvt set previewer
# regular preview script
map zvr set previewer ~/.config/lf/pv.sh
# full preview script
map zvf set previewer ~/.config/lf/scope.sh
# display file with preview script
map i $~/.config/lf/pv.sh $f | less -R
# display all images from a dir with nsxiv-rifle
cmd view-all-pics &~/.config/lf/nsxiv-rifle $PWD
map V view-all-pics
# toggle hidden files
map <backspace> set hidden!
map <backspace2> set hidden!

# commands & keybinds ###########################
# use enter for shell commands
map <enter> shell
# show the result of execution of previous commands
map ` !true
# execute current file (must be executable)
map x $$f
map X !$f
# read input
map ':' read
# edit file with default editor
#map e $$EDITOR $f
map e $nano $f
# edit file with GUI editor
map E &geany $f
# display usage of current dir and subdirs
map U $du -shc * | sort -hr | less -R
# check git
cmd gitstats !git status
map gs gitstats

# navigation ######################################
map gh cd ~
map gm cd /media
map gc cd ~/.config
map gd cd ~/dev
cmd newlf &{{
    [ "$(echo "$XDG_SESSION_DESKTOP")" = "sway" ] && footclient --title=filer --app-id=filer lf || urxvtcd -e lf
}}
map gn newlf
map <c-right> newlf
map gb jump-prev
map gB jump-next
# quit with 'q' or 'Ctrl+q'
map <c-q> quit
# open files #########################################
# default open with xdg-open
map o &xdg-open $f
# define a custom 'open' command - filter by mimetype
cmd open &{{
    case $(file --mime-type -Lb $f) in
        #text/*) lf -remote "send $id \$$EDITOR \$fx";;
        text/*) lf -remote "send $id \$nano \$fx";;
        image/x-xcf) lf -remote "send $id \$gimp \$fx &";;
        image/*) lf -remote "send $id \$nsxiv -p \$fx &";;
        audio/*|video/*) lf -remote "send $id \$mpv --no-terminal \$fx &";;
        *) for f in $fx; do $OPENER $f > /dev/null 2> /dev/null & done;;
    esac
}}

# special commands ##################################
# extract the current file with the right command
cmd extract ${{
    set -f
    case $f in
        *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjvf $f;;
        *.tar.gz|*.tgz) tar xzvf $f;;
        *.tar.xz|*.txz) tar xJvf $f;;
        *.zip) unzip $f;;
        *.rar) unrar x $f;;
        *.7z) 7z x $f;;
        *) dtrx $f;;
    esac
}}
# compress current file or selected files with tar and gunzip
cmd tgz ${{
    set -f
    mkdir $1
    cp -r $fx $1
    tar czf $1.tar.gz $1
    rm -rf $1
}}
# compress current file or selected files with zip
cmd zip ${{
    set -f
    mkdir $1
    cp -r $fx $1
    zip -r $1.zip $1
    rm -rf $1
}}

# Kanagawa Theme for Micro Text Editor
# Inspired by rebelot/kanagawa.nvim

color-link default "#DCD7BA,#1F1F28"
color-link comment "#727169"

color-link identifier "#E6C384"
color-link identifier.class "#7E9CD8"
color-link identifier.var "#E4973A"

color-link constant "#957FB8"
color-link constant.number "#D27E99"
color-link constant.string "#98BB6C"

color-link statement "#957FB8"
color-link preproc "#E46876"
color-link type "#7E9CD8"
color-link special "#FF9E3B"

color-link underlined "#7E9CD8"
color-link error "bold #E82424"
color-link todo "bold #FF9E3B"

color-link statusline "#C8C093,#2A2A37"
color-link tabbar "#C8C093,#2A2A37"
color-link indent-char "#54546D"
color-link line-number "#54546D"
color-link current-line-number "#C8C093"

color-link cursor-line "#363646"
color-link color-column "#2A2A37"
color-link type.keyword "#E46876"

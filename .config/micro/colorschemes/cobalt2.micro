# micro theme in the style of Cobalt2

color-link default "#ffffff,#193549"
color-link comment "#007100"

# Синтаксис кода и конфигов
color-link identifier "#00e5ff"
color-link statement "#ff9f1c"
color-link preproc "#ff007f"
color-link type "#ffc600"
color-link special "#9d4edd"
color-link string "#3ad900"
color-link constant "#ffc600"

# Элементы интерфейса редактора
color-link line-number "#5f7e97,#122738"
color-link current-line-number "#ffc600,#1f4662"
color-link cursor-line "#1f4662"
color-link color-column "#122738"
color-link statusline "#ffffff,#122738"
color-link tabbar "#ffffff,#122738"
color-link indent-char "#5f7e97"

# Выделение текста и поиск
color-link selection "#ffffff,#005080"
color-link match-brace "#ffc600,#1f4662"
color-link rubyRegexp "#00e5ff"
